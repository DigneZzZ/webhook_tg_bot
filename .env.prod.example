# Production Environment Configuration
# Copy this file to .env.prod and fill in your actual values

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_production_telegram_bot_token_here
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_THREAD_ID=0

# Webhook Configuration
WEBHOOK_SECRET=your_production_secret_key_here
WEBHOOK_PORT=9952
WEBHOOK_PATH=/your_webhook_path_here

# AI Configuration
OPENAI_API_KEY=your_production_openai_api_key_here
# Model name is passed to the API as-is: gpt-5.6-luna, gpt-5.4-nano, gpt-5-nano etc.
OPENAI_MODEL=gpt-5.6-luna
# Optional: proxy / OpenAI-compatible gateway if api.openai.com is unreachable
#OPENAI_BASE_URL=https://your-proxy.example.com/v1

# Base URL for your forum
BASE_URL=https://your-production-forum.com

# Webhook domain (optional, if empty will use server IP)
WEBHOOK_DOMAIN=your-webhook-domain.com

# Premium categories (comma-separated category IDs)
PREMIUM_CATEGORIES=4,5,6

# Subscription configurations (multiple subscriptions support)
# Each subscription has a name, categories, and bot text

# Subscription 1 - Main VIP subscription
SUBSCRIPTION_NAME_1=VIP подписка
SUBSCRIPTION_CATEGORIES_1=10,11,12,13,22,23,24
SUBSCRIPTION_BOT_TEXT_1=Оформить VIP подписку можно в тг-боте: https://t.me/your_bot

# Subscription 2 - SHM access
SUBSCRIPTION_NAME_2=Доступ к материалам SHM
SUBSCRIPTION_CATEGORIES_2=5
SUBSCRIPTION_BOT_TEXT_2=Приобрести доступ к SHM можно в тг-боте: https://t.me/your_bot

# You can add up to 10 subscriptions (SUBSCRIPTION_NAME_3, etc.)

# Categories to monitor (comma-separated category IDs, empty = monitor all)
MONITORED_CATEGORIES=

# Categories to ignore (comma-separated category IDs, priority over monitored)
IGNORED_CATEGORIES=

# User IDs to ignore (comma-separated user IDs, including negative IDs for bots)
# Example: -2 is typically discobot, -1 might be system bot, chatbot etc.
# Use https://your-forum.com/admin/users/USER_ID to check user IDs
IGNORED_USERS=-2,-1

# Additional Telegram Threads for specific categories
# Format: THREAD_CATEGORIES_X=category_id1,category_id2,category_id3
# TELEGRAM_THREAD_ID_X=thread_message_id

# Thread 1 - Example: Programming categories
#TELEGRAM_THREAD_ID_1=123456
#THREAD_CATEGORIES_1=1,2,3

# Thread 2 - Example: Design categories  
#TELEGRAM_THREAD_ID_2=234567
#THREAD_CATEGORIES_2=4,5

# Thread 3 - Example: Business categories
#TELEGRAM_THREAD_ID_3=345678
#THREAD_CATEGORIES_3=6,7,8

# Thread 4 - Example: Hardware categories
#TELEGRAM_THREAD_ID_4=456789
#THREAD_CATEGORIES_4=9,10

# Thread 5 - Example: Off-topic categories
#TELEGRAM_THREAD_ID_5=567890
#THREAD_CATEGORIES_5=11,12,13
